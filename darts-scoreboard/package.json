{
  "name": "bullseye-darts-scoreboard",
  "productName": "Bullseye Darts Scoreboard",
  "version": "1.2.3",
  "description": "All-in-one darts scoreboard: 46 games incl. SA Killer with authentic house rules, chalkboards, checkout calculators, split-legs — web + Windows + Android",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "stage": "node scripts/stage-deploy.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/add-sri.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && node scripts/add-sri.mjs && electron-builder --win nsis",
    "electron:start": "electron .",
    "release": "node scripts/release.mjs",
    "release:web": "node scripts/release.mjs --web-only",
    "release:beta": "node scripts/release.mjs --beta-only"
  },
  "build": {
    "appId": "com.webslabs.bullseye-darts",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bullseye Darts"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@supabase/supabase-js": "^2.58.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "adm-zip": "^0.6.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@38.8.6": true
  }
}
